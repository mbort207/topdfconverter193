#!/usr/bin/env bash
# else
if [[ "$1" == *.png ]]; then
	output="${1%.png}.pdf"
	magick "$1" -quality 100 "$output"
	if [ $? -eq 0 ]; then
		echo "Converted: $1 -> $output"
	else
		echo "could not create file"
		exit 1
	fi
	exit 0	
